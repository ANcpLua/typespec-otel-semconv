<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      Local source for Nuke.OpenTelemetry.Conventions during pre-publish development.
      Resolves the locally-built .nupkg in
      ~/RiderProjects/Nuke.OpenTelemetry.Conventions/src/Nuke.OpenTelemetry.Conventions/bin/Release/.
      Remove this entry once the package is published to a real feed.
    -->
    <add key="nuke-otel-conventions-local" value="../../Nuke.OpenTelemetry.Conventions/src/Nuke.OpenTelemetry.Conventions/bin/Release" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="nuke-otel-conventions-local">
      <package pattern="Nuke.OpenTelemetry.Conventions" />
    </packageSource>
  </packageSourceMapping>
</configuration>
