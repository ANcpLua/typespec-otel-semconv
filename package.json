{
  "name": "@ancplua/typespec-otel-semconv",
  "version": "1.41.0-1",
  "description": "Weaver-based TypeSpec projection of OpenTelemetry semantic conventions, pinned at v1.41.0. Personal sandbox; not an official OpenTelemetry artifact.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./lib/otel-keys.gen.tsp"
  },
  "files": [
    "lib/**/*.tsp",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "generate": "bash scripts/run-weaver.sh",
    "verify-clean": "bash scripts/run-weaver.sh && git diff --exit-code -- lib/ && test -z \"$(git status --porcelain -- lib/)\"",
    "lint:smoke": "tsp compile test/smoke.tsp --warn-as-error --no-emit",
    "test": "vitest run",
    "check": "npm run verify-clean && npm run lint:smoke && npm run test"
  },
  "peerDependencies": {
    "@typespec/compiler": "^1.11.0 || >=1.12.0-dev.0"
  },
  "devDependencies": {
    "@typespec/compiler": "1.12.0-dev.12",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  },
  "metadata": {
    "semconvVersion": "v1.41.0",
    "weaverVersion": "v0.23.0",
    "upstreamRepo": "https://github.com/open-telemetry/semantic-conventions",
    "upstreamCommit": "e018fe6f91862f5ed63c082f87697cddac596784"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ANcpLua/typespec-otel-semconv.git"
  },
  "engines": {
    "node": ">=22"
  }
}
